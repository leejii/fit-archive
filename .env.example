# FitArchive 환경 변수 템플릿
# 사용법: 이 파일을 복사해 .env.local 을 만들고 값을 채우세요.
#   cp .env.example .env.local
# .env.local 은 .gitignore 에 의해 커밋되지 않습니다. (이 .env.example 만 커밋됨)
#
# 값 위치: Supabase 대시보드 > 프로젝트 > Settings > API (또는 API Keys)

# ── V1 필수 (이 2개만 채우면 동작) ─────────────────────────────
# 공개 가능 — 브라우저에 노출되어도 되는 값 (RLS 로 보호됨)
# ANON_KEY 칸에는 최신 대시보드의 "Publishable key"(sb_publishable_...) 를 넣으세요.
# (Legacy API Keys 의 anon/public JWT(eyJ...) 를 넣어도 동작합니다)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 선택 (V1 불필요 · 비워두기) ────────────────────────────────
# service_role 은 RLS 를 우회하는 관리자 권한 키.
# V1 은 "로그인 세션 + RLS" 로만 동작하므로 필요 없습니다.
# 나중에 서버 전용 관리 작업이 생기면 그때 채우세요.
# 📛 채우게 되면: 절대 클라이언트 노출/커밋 금지.
# SUPABASE_SERVICE_ROLE_KEY=
